@model SmartStock.Models.StockOut
@{
    ViewBag.Title = "Stock Out Details";
}

<h2>Stock Out Details</h2>

<dl class="dl-horizontal">
    <dt>Product</dt>
    <dd>@Model.Product.ProductName (@Model.Product.ProductCode)</dd>

    <dt>Quantity</dt>
    <dd>@Model.Quantity</dd>

    <dt>Date</dt>
    <dd>@Model.StockOutDate.ToString("yyyy-MM-dd HH:mm")</dd>

    <dt>Purpose</dt>
    <dd>@Model.Purpose</dd>

    <dt>Reference No</dt>
    <dd>@Model.ReferenceNo</dd>

    <dt>Remarks</dt>
    <dd>@Model.Remarks</dd>

    <dt>Current Stock (after this transaction)</dt>
    <dd><strong>@Model.Product.CurrentStock</strong></dd>
</dl>

@Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })