@model IEnumerable<SmartStock.Models.StockOut>
@{
    ViewBag.Title = "Stock Out";
}

<h2>Stock Out</h2>
<p>@Html.ActionLink("+ New Stock Out", "Create", null, new { @class = "btn btn-primary" })</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Date</th>
            <th>Purpose</th>
            <th>Reference</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Product.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.StockOutDate.ToString("yyyy-MM-dd")</td>
                <td>@item.Purpose</td>
                <td>@item.ReferenceNo</td>
                <td>@Html.ActionLink("View", "Details", new { id = item.StockOutId }, new { @class = "btn btn-sm btn-info" })</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    Html.RenderPartial("_EmptyState", "No stock out transactions yet. Click \"+ New Stock Out\" to add one.");
}