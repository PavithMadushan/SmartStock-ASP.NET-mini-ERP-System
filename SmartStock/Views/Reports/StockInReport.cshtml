@using System.Linq
@model SmartStock.ViewModels.StockInReportViewModel
@{
    ViewBag.Title = "Stock In Report";
}

<div class="no-print" style="margin-bottom: 15px;">
    <h2>Stock In Report</h2>

    @using (Html.BeginForm("StockInReport", "Reports", FormMethod.Get, new { @class = "form-inline" }))
    {
        <div class="form-group">
            <label>From:</label>
            @Html.TextBox("fromDate", Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "", new { @class = "form-control", type = "date" })
        </div>
        <div class="form-group">
            <label>To:</label>
            @Html.TextBox("toDate", Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : "", new { @class = "form-control", type = "date" })
        </div>
        <div class="form-group">
            @Html.DropDownList("productId", Model.ProductList, "All Products", new { @class = "form-control" })
        </div>
        <div class="form-group">
            @Html.DropDownList("supplierId", Model.SupplierList, "All Suppliers", new { @class = "form-control" })
        </div>
        <button type="submit" class="btn btn-default">Filter</button>
        @Html.ActionLink("Reset", "StockInReport", null, new { @class = "btn btn-link" })
    }

    <div style="margin-top: 10px;">
        <button onclick="window.print();" class="btn btn-default">Print Report</button>
        @Html.ActionLink("Export to Excel", "ExportStockInReport", new { fromDate = Model.FromDate, toDate = Model.ToDate, productId = Model.ProductId, supplierId = Model.SupplierId }, new { @class = "btn btn-success" })
        @Html.ActionLink("Back to Reports", "Index", null, new { @class = "btn btn-link" })
    </div>
</div>

<h3 class="visible-print-block" style="display:none;">Stock In Report</h3>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Product</th>
            <th>Supplier</th>
            <th>Quantity</th>
            <th>Unit Cost</th>
            <th>Total Cost</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Results)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.SupplierName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitCost.ToString("N2")</td>
                <td>@item.TotalCost.ToString("N2")</td>
                <td>@item.StockInDate.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="4" class="text-right">Total:</th>
            <th>@Model.TotalCost.ToString("N2")</th>
            <th></th>
        </tr>
    </tfoot>
</table>

@if (Model.Results == null || !Model.Results.Any())
{
    Html.RenderPartial(
        "_EmptyState",
        "No stock in transactions found for the selected filters."
    );
}