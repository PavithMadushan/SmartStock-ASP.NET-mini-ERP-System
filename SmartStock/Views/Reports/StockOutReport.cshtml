@using System.Linq

@model SmartStock.ViewModels.StockOutReportViewModel
@{
    ViewBag.Title = "Stock Out Report";
}

<div class="no-print" style="margin-bottom: 15px;">
    <h2>Stock Out Report</h2>

    @using (Html.BeginForm("StockOutReport", "Reports", FormMethod.Get, new { @class = "form-inline" }))
    {
        <div class="form-group">
            <label>From:</label>
            @Html.TextBox("fromDate", Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "", new { @class = "form-control", type = "date" })
        </div>
        <div class="form-group">
            <label>To:</label>
            @Html.TextBox("toDate", Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : "", new { @class = "form-control", type = "date" })
        </div>
        <div class="form-group">
            @Html.DropDownList("productId", Model.ProductList, "All Products", new { @class = "form-control" })
        </div>
        <button type="submit" class="btn btn-default">Filter</button>
        @Html.ActionLink("Reset", "StockOutReport", null, new { @class = "btn btn-link" })
    }

    <div style="margin-top: 10px;">
        <button onclick="window.print();" class="btn btn-default">Print Report</button>
        @Html.ActionLink("Export to Excel", "ExportStockOutReport", new { fromDate = Model.FromDate, toDate = Model.ToDate, productId = Model.ProductId }, new { @class = "btn btn-success" })
        @Html.ActionLink("Back to Reports", "Index", null, new { @class = "btn btn-link" })
    </div>
</div>

<h3 class="visible-print-block" style="display:none;">Stock Out Report</h3>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Purpose</th>
            <th>Date</th>
            <th>Reference</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Results)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.Purpose</td>
                <td>@item.StockOutDate.ToString("yyyy-MM-dd")</td>
                <td>@item.ReferenceNo</td>
            </tr>
        }
    </tbody>
</table>


@if (Model.Results == null || !Model.Results.Any())
{
    Html.RenderPartial(
        "_EmptyState",
        "No stock out transactions found for the selected filters."
    );
}