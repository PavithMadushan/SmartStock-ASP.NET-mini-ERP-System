@model IEnumerable<SmartStock.ViewModels.StockSummaryReportItem>
@{
    ViewBag.Title = "Stock Summary Report";
}

<div class="no-print" style="margin-bottom: 15px;">
    <h2>Stock Summary Report</h2>
    <button onclick="window.print();" class="btn btn-default">Print Report</button>
    @Html.ActionLink("Export to Excel", "ExportStockSummary", null, new { @class = "btn btn-success" })
    @Html.ActionLink("Back to Reports", "Index", null, new { @class = "btn btn-link" })
</div>

<h3 class="visible-print-block" style="display:none;">Stock Summary Report</h3>
<p class="visible-print-block" style="display:none;">Generated: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Product Code</th>
            <th>Product Name</th>
            <th>Category</th>
            <th>Current Stock</th>
            <th>Reorder Level</th>
            <th>Unit Price</th>
            <th>Stock Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.CurrentStock <= item.ReorderLevel ? "danger" : "")">
                <td>@item.ProductCode</td>
                <td>@item.ProductName</td>
                <td>@item.CategoryName</td>
                <td>@item.CurrentStock</td>
                <td>@item.ReorderLevel</td>
                <td>@item.UnitPrice.ToString("N2")</td>
                <td>@item.StockValue.ToString("N2")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="6" class="text-right">Total Stock Value:</th>
            <th>@Model.Sum(m => m.StockValue).ToString("N2")</th>
        </tr>
    </tfoot>
</table>