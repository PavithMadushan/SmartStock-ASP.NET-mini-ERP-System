@model SmartStock.ViewModels.DashboardViewModel
@using Newtonsoft.Json
@{
    ViewBag.Title = "Dashboard";
}

<h2>Dashboard</h2>

<!-- Top KPI Cards (3 small cards) -->
<div class="row">
    <div class="col-md-4 col-sm-6">
        <div class="kpi-card kpi-products">
            <p class="kpi-label">Total Products</p>
            <h3>@Model.TotalProducts</h3>
            <small class="text-muted">All Items</small>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="kpi-card kpi-stockin">
            <p class="kpi-label">Total Stock In</p>
            <h3>@Model.TotalStockInThisMonth</h3>
            <small class="text-muted">This Month</small>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="kpi-card kpi-stockout">
            <p class="kpi-label">Total Stock Out</p>
            <h3>@Model.TotalStockOutThisMonth</h3>
            <small class="text-muted">This Month</small>
        </div>
    </div>
</div>

<!-- Current Stock Value banner: LKR on the left, live conversions on the right -->
<div class="row">
    <div class="col-md-12">
        <div class="kpi-value-banner">
            <div class="value-banner-left">
                <p class="kpi-label">Current Stock Value</p>
                <h3>Rs. @Model.CurrentStockValue.ToString("N0")</h3>
                <small class="text-muted">Total Value (LKR)</small>
            </div>

            @if (Model.ExchangeRatesAvailable)
            {
                <div class="value-banner-right">
                    <div class="currency-chip">
                        <span class="currency-code">USD</span>
                        <span class="currency-amount">@Model.CurrentStockValueUSD.ToString("N2")</span>
                    </div>
                    <div class="currency-chip">
                        <span class="currency-code">AUD</span>
                        <span class="currency-amount">@Model.CurrentStockValueAUD.ToString("N2")</span>
                    </div>
                    <div class="currency-chip">
                        <span class="currency-code">NZD</span>
                        <span class="currency-amount">@Model.CurrentStockValueNZD.ToString("N2")</span>
                    </div>
                </div>
            }
            else
            {
                <div class="value-banner-right">
                    <small class="text-muted">Live exchange rates are currently unavailable.</small>
                </div>
            }
        </div>
        @if (Model.ExchangeRatesAvailable)
        {
            <small class="text-muted exchange-rate-date">Exchange rates as of @Model.ExchangeRatesAsOfDate (source: Frankfurter API)</small>
        }
    </div>
</div>

<!-- Charts -->
<div class="row">
    <div class="col-md-7">
        <div class="chart-card">
            <h4>Monthly Stock Movement</h4>
            <canvas id="stockMovementChart" height="250"></canvas>
        </div>
    </div>
    <div class="col-md-5">
        <div class="chart-card">
            <h4>Stock by Category</h4>
            <canvas id="categoryChart" height="250"></canvas>
        </div>
    </div>
</div>

<!-- Low Stock Alert -->
<div class="chart-card">
    <h4>Low Stock Products</h4>

    @if (Model.LowStockProducts.Any())
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Current Stock</th>
                    <th>Reorder Level</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.LowStockProducts)
                {
                    <tr class="low-stock-row">
                        <td>@item.ProductName</td>
                        <td>@item.CategoryName</td>
                        <td>@item.CurrentStock</td>
                        <td>@item.ReorderLevel</td>
                        <td>@Html.ActionLink("View", "Edit", "Products", new { id = item.ProductId }, new { @class = "btn btn-sm btn-warning" })</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        Html.RenderPartial("_EmptyState", "No low stock products right now. Everything is well stocked.");
    }
</div>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.min.js"></script>
    <script>
        var months = @Html.Raw(JsonConvert.SerializeObject(Model.ChartMonths));
        var stockInData = @Html.Raw(JsonConvert.SerializeObject(Model.MonthlyStockIn));
        var stockOutData = @Html.Raw(JsonConvert.SerializeObject(Model.MonthlyStockOut));
        var categoryLabels = @Html.Raw(JsonConvert.SerializeObject(Model.CategoryLabels));
        var categoryValues = @Html.Raw(JsonConvert.SerializeObject(Model.CategoryValues));

        var ctx1 = document.getElementById('stockMovementChart').getContext('2d');
        new Chart(ctx1, {
            type: 'bar',
            data: {
                labels: months,
                datasets: [
                    { label: 'Stock In', data: stockInData, backgroundColor: '#2563eb' },
                    { label: 'Stock Out', data: stockOutData, backgroundColor: '#f43f5e' }
                ]
            },
            options: {
                responsive: true,
                scales: { yAxes: [{ ticks: { beginAtZero: true } }] }
            }
        });

        var ctx2 = document.getElementById('categoryChart').getContext('2d');
        new Chart(ctx2, {
            type: 'doughnut',
            data: {
                labels: categoryLabels,
                datasets: [{
                    data: categoryValues,
                    backgroundColor: ['#2563eb', '#16a34a', '#f59e0b', '#9333ea', '#64748b']
                }]
            },
            options: { responsive: true }
        });
    </script>
}